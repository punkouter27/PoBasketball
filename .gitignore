sim/runs_*.log
sim/runs_*.err
sim/**/__pycache__/
*.pyc
.pytest_cache/

# Unreal
unreal/StreetballGym/Binaries/
unreal/StreetballGym/Intermediate/
unreal/StreetballGym/Saved/
unreal/StreetballGym/DerivedDataCache/
unreal/StreetballGym/.vs/
unreal/StreetballGym/*.sln
unreal/StreetballGym/Plugins/*/Binaries/
