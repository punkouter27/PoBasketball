unreal/StreetballGym/Content/Project/RL_Policies/policies/

# Local scratch
SCREENSHOTS/*.png

# AMP mocap (LocoMuJoCo data, CC BY-NC-ND 4.0: never commit or ship)
sim/data/mocap/

# Web viewer build output (web/build.py)
web/dist/

# Logs and generated IDE solutions (never tracked)
*.log
*.err
tensorboard.*
unreal/StreetballGym/*.slnx
.venv*/

# Quixel Megascans from Fab (Standard License: no redistribution of the files themselves; this repo is public).
# Downloads are imported locally by unreal/StreetballGym/Scripts/import_megascans.py from Content/Art/megascans.json;
# without them the game keeps its procedural materials.
unreal/StreetballGym/Content/Art/Raw/Megascans/
unreal/StreetballGym/Content/Project/Environments/Megascans/
